# Address of the BaskyCLub API (baskyclub-server). Copy to .env.local and adjust.
# iOS simulator / web on the same Mac:  http://localhost:3000
# Android emulator:                     http://10.0.2.2:3000
# Real phone on the same Wi-Fi:         http://<your Mac Wi-Fi IP>:3000   (find it: ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=http://localhost:3000
