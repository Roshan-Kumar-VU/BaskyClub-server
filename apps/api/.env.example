# Copy this file to .env and fill in the values. Never commit .env.

# Database (Mac: Postgres.app; later Supabase or AWS — only these two lines change)
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/baskyclub_local"
DIRECT_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/baskyclub_local"

# Separate throwaway database for automated tests (npm test erases it). Create it once with:
#   createdb baskyclub_test && npm run test:prepare
TEST_DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/baskyclub_test"

# Login tokens. Any long random text; make a new one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Public address of this API (links to uploaded photos: API_URL/api/files/...)
API_URL="http://localhost:3000"
# Public address of the website, apps/web (parent-consent and password emails, shared post links)
WEB_URL="http://localhost:3001"

# Emails: "log" prints them in Terminal (default). Later: EMAIL_DRIVER="resend" + RESEND_API_KEY + EMAIL_FROM
EMAIL_DRIVER="log"
# Phone alerts: "log" only records them (default while testing). Later: PUSH_DRIVER="expo"
PUSH_DRIVER="log"
# Photos: "local" saves them in ./uploads (default). Supabase Storage / S3 later.
STORAGE_DRIVER="local"
