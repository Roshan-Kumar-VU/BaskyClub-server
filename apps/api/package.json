{
  "name": "@baskyclub/api",
  "version": "0.1.0",
  "private": true,
  "description": "BaskyCLub backend: the API for the website (apps/web) and the app (apps/mobile).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:prepare": "tsx scripts/prepare-test-db.ts",
    "test": "tsx --test --test-force-exit --test-concurrency=1 tests/*.test.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@baskyclub/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "jose": "6.2.14",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "prisma": "5.22.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
