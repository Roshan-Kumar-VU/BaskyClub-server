// =============================================================================
// BaskyCLub — Phase 1 schema ("join clubs and post")          PROPOSAL, 26 Oct 2026
//
// 28 tables: 12 base (never removed, only gain columns) + 16 on top.
// Source: Database Guide + Decision log #1–72, REQUIREMENTS_PHASES.md section 8.
// Phase 2 adds 8 tables (player_profiles, teams, team_rosters, matches,
// match_lineups, match_events, tournaments, tournament_registrations); they only
// point into tables below, so nothing here changes when they arrive.
//
// Conventions
// - Code names camelCase, database names snake_case (@map / @@map).
// - IDs are UUIDs, except places, which use fixed codes ("TN", "TN-VELLORE").
// - Status-type values are plain text with the allowed values in a comment
//   (fixed lists / enums come later, one column at a time).
// - Rules Prisma cannot express (one-active-row indexes, counters kept by the
//   database) are in phase1_extras.sql and go into the same baseline migration.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// PEOPLE & CONTROL
// =============================================================================

/// BASE. Login account + profile page (#72). Stats/player profile: Phase 2.
model User {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  email            String    @unique // stored lowercase
  phone            String    @unique // +91XXXXXXXXXX (src/lib/phone.ts)
  passwordHash     String    @map("password_hash") // one-way, never readable
  dateOfBirth      DateTime  @map("date_of_birth") @db.Date // never public
  gender           String? // "male" | "female" | "other"
  homeDistrictCode String?   @map("home_district_code")
  // Profile page (#72)
  photoUrl         String?   @map("photo_url")
  coverPhotoUrl    String?   @map("cover_photo_url")
  bio              String?
  instagram        String? // hidden on the profile for under-18 users
  youtube          String? // hidden on the profile for under-18 users
  pinnedPostId     String?   @unique @map("pinned_post_id") @db.Uuid
  // Account state: "active" | "limited" (under-18 awaiting parent) | "suspended" | "deleted"
  status           String    @default("active")
  signupIp         String?   @map("signup_ip")
  lastLoginIp      String?   @map("last_login_ip")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  homeDistrict District? @relation(fields: [homeDistrictCode], references: [code], onDelete: SetNull)
  pinnedPost   Post?     @relation("PinnedPost", fields: [pinnedPostId], references: [id], onDelete: SetNull)

  platformRoles        PlatformRole[]       @relation("RoleHolder")
  platformRolesGranted PlatformRole[]       @relation("RoleGrantedBy")
  parentalConsents     ParentalConsent[]
  deviceTokens         DeviceToken[]
  changes              ChangeLog[]
  orgMemberships       OrganizationMember[] @relation("OrgMember")
  orgGrants            OrganizationMember[] @relation("OrgGrantedBy")
  officeBearerRoles    OfficeBearer[]       @relation("BearerPerson")
  officeBearerEntries  OfficeBearer[]       @relation("BearerEnteredBy")
  orgsCreated          Organization[]       @relation("OrgCreatedBy")
  legacyCreated        LegacyRecord[]
  clubsCreated         Club[]               @relation("ClubCreatedBy")
  clubsDeleted         Club[]               @relation("ClubDeletedBy")
  memberships          ClubMembership[]     @relation("Member")
  membershipsApproved  ClubMembership[]     @relation("MemberApprovedBy")
  clubRoles            ClubRole[]           @relation("ClubRoleHolder")
  clubRolesGranted     ClubRole[]           @relation("ClubRoleGrantedBy")
  coachRoles           Coach[]
  affiliationsAsked    Affiliation[]        @relation("AffRequestedBy")
  affiliationsDecided  Affiliation[]        @relation("AffDecidedBy")
  badgesGiven          VerificationBadge[]  @relation("BadgeGivenBy")
  badges               VerificationBadge[]  @relation("BadgeHolder")
  courtsCreated        Court[]
  posts                Post[]               @relation("PostAuthor")
  postLikes            PostLike[]
  postComments         PostComment[]
  follows              Follow[]
  reportsMade          ModerationCase[]     @relation("CaseReportedBy")
  casesReviewed        ModerationCase[]     @relation("CaseReviewedBy")
  announcementsSent    Announcement[]

  @@index([homeDistrictCode])
  @@map("users")
}

/// BASE. BaskyCLub-wide powers with history (#12, #43, #44). Replaces users.is_super_admin.
model PlatformRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String // "super_admin" | "basky_admin" | "moderator"
  grantedById String?   @map("granted_by") @db.Uuid // empty only for the first super admin
  fromAt      DateTime  @default(now()) @map("from_at")
  toAt        DateTime? @map("to_at") // empty = current

  user      User  @relation("RoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, toAt])
  @@map("platform_roles")
}

/// ON TOP. Parent confirms an under-18 account by email link (#67).
model ParentalConsent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  parentName  String    @map("parent_name")
  parentEmail String    @map("parent_email")
  tokenHash   String    @unique @map("token_hash") // hash of the emailed link token
  status      String    @default("sent") // "sent" | "confirmed" | "expired"
  sentAt      DateTime  @default(now()) @map("sent_at")
  confirmedAt DateTime? @map("confirmed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("parental_consents")
}

/// ON TOP. Phones/browsers that receive announcements.
model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique // Expo push token
  platform   String // "ios" | "android" | "web"
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// BASE. Who changed what, for every admin action (#61).
model ChangeLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_user_id") @db.Uuid
  entity      String // table name, e.g. "districts"
  entityId    String   @map("entity_id")
  action      String // "create" | "update" | "delete"
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  at          DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@map("change_log")
}

// =============================================================================
// PLACES (seeded from states_india.csv, districts_india.csv, zones.csv)
// =============================================================================

/// BASE. 36 states and union territories.
model State {
  code String @id // "TN"
  name String // "Tamil Nadu"
  type String // "state" | "union_territory"

  districts     District[]
  zones         Zone[]
  organizations Organization[]

  @@map("states")
}

/// ON TOP. Basketball zones per state; editable from super-admin screens (#18, #61).
model Zone {
  code           String  @id // "TN-Z-CHN"
  stateCode      String  @map("state_code")
  name           String // "Chennai Zone"
  hqDistrictCode String? @map("hq_district_code")
  isProvisional  Boolean @default(true) @map("is_provisional")

  state      State      @relation(fields: [stateCode], references: [code])
  hqDistrict District?  @relation("ZoneHq", fields: [hqDistrictCode], references: [code], onDelete: SetNull)
  districts  District[] @relation("ZoneMember")

  @@map("zones")
}

/// BASE. 786 districts; every club, court, user and post is placed by its code.
model District {
  code          String  @id // "TN-VELLORE"
  name          String
  stateCode     String  @map("state_code")
  lgdCode       String? @map("lgd_code") // government LGD code
  altName       String? @map("alt_name") // older / alternative spelling
  shortCode     String? @map("short_code") // "VEL"
  zoneCode      String? @map("zone_code")
  associationId String? @map("association_id") @db.Uuid // covering association (#61)
  isProvisional Boolean @default(false) @map("is_provisional")

  state       State         @relation(fields: [stateCode], references: [code])
  zone        Zone?         @relation("ZoneMember", fields: [zoneCode], references: [code], onDelete: SetNull)
  association Organization? @relation("Coverage", fields: [associationId], references: [id], onDelete: SetNull)

  zonesHeaded   Zone[]         @relation("ZoneHq")
  users         User[]
  clubs         Club[]
  courts        Court[]
  posts         Post[]
  announcements Announcement[]

  @@index([stateCode])
  @@index([associationId])
  @@map("districts")
}

// =============================================================================
// ORGANIZATIONS
// =============================================================================

/// BASE. BFI, TNBA, district associations, league operators (#19, #59, #60).
model Organization {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  shortName      String?   @map("short_name")
  level          String // "national" | "state" | "district" | "league_operator"
  parentId       String?   @map("parent_id") @db.Uuid // BFI -> TNBA -> district; empty for national and league operators
  stateCode      String?   @map("state_code")
  pageStatus     String    @default("draft") @map("page_status") // "draft" | "published" | "claimed"
  registrationNo String?   @map("registration_no")
  logoUrl        String?   @map("logo_url")
  contactEmail   String?   @map("contact_email")
  contactPhone   String?   @map("contact_phone")
  address        String?
  website        String?
  createdById    String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  claimedAt      DateTime? @map("claimed_at")

  parent           Organization?        @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Organization[]       @relation("OrgTree")
  state            State?               @relation(fields: [stateCode], references: [code])
  createdBy        User?                @relation("OrgCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  coveredDistricts District[]           @relation("Coverage")
  members          OrganizationMember[]
  officeBearers    OfficeBearer[]
  legacyRecords    LegacyRecord[]
  affiliations     Affiliation[]
  posts            Post[]
  announcements    Announcement[]

  @@index([level, stateCode])
  @@map("organizations")
}

/// BASE. App accounts with power in an association, with history (#13, #15, #44).
model OrganizationMember {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  accessLevel    String    @map("access_level") // "owner" | "admin" | "member"
  grantedById    String?   @map("granted_by") @db.Uuid
  fromAt         DateTime  @default(now()) @map("from_at")
  toAt           DateTime? @map("to_at") // empty = current

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrgMember", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("OrgGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([organizationId, toAt])
  @@index([userId])
  @@map("organization_members")
}

/// ON TOP. Real titles with term dates (#16, #45, #62). Replaces federation_nodes.
model OfficeBearer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid // optional link to an account
  name           String
  designation    String // "President" | "Vice-President" | "General Secretary" | "Secretary" | "Joint Secretary" | "Treasurer" | ...
  photoUrl       String?   @map("photo_url")
  sortOrder      Int       @default(0) @map("sort_order")
  termFrom       DateTime  @map("term_from") @db.Date
  termTo         DateTime? @map("term_to") @db.Date // empty = current
  enteredById    String?   @map("entered_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("BearerPerson", fields: [userId], references: [id], onDelete: SetNull)
  enteredBy    User?        @relation("BearerEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@index([organizationId, termTo])
  @@map("office_bearers")
}

/// ON TOP. District history and records of tournaments conducted (#66).
/// Phase 2 adds an optional tournament_id.
model LegacyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  recordType     String   @map("record_type") // "history" | "tournament_record" | "achievement"
  title          String
  year           Int?
  body           String?
  winner         String?
  runnerUp       String?  @map("runner_up")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  media        LegacyMedia[]

  @@index([organizationId, year])
  @@map("legacy_records")
}

/// ON TOP. Photos and YouTube links for a legacy record.
model LegacyMedia {
  id             String @id @default(uuid()) @db.Uuid
  legacyRecordId String @map("legacy_record_id") @db.Uuid
  mediaType      String @map("media_type") // "image" | "youtube"
  url            String
  sortOrder      Int    @default(0) @map("sort_order")

  record LegacyRecord @relation(fields: [legacyRecordId], references: [id], onDelete: Cascade)

  @@map("legacy_media")
}

// =============================================================================
// CLUBS
// =============================================================================

/// BASE. Clubs, academies, creator groups, franchises (#20, #58).
/// "Affiliated" is never stored here: it is an active row in affiliations.
model Club {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  kind         String    @default("club") // "club" | "academy" | "creator_group" | "franchise"
  districtCode String    @map("district_code")
  status       String    @default("pending") // "pending" | "approved" | "suspended"
  description  String?
  motto        String?
  logoUrl      String?   @map("logo_url")
  bannerUrl    String?   @map("banner_url")
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  baskyNumber  String?   @unique @map("basky_number") // Phase 2 ID card; column ready
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") // soft delete
  deletedById  String?   @map("deleted_by") @db.Uuid

  district      District            @relation(fields: [districtCode], references: [code])
  createdBy     User?               @relation("ClubCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedBy     User?               @relation("ClubDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  memberships   ClubMembership[]
  roles         ClubRole[]
  coaches       Coach[]
  affiliations  Affiliation[]
  badges        VerificationBadge[]
  courts        Court[]
  timings       ClubCourtTiming[]
  posts         Post[]
  announcements Announcement[]

  @@index([districtCode, status])
  @@index([kind])
  @@map("clubs")
}

/// BASE. One row per stint; a join request starts as "pending" (#17, #63).
/// Only one pending/active row per (club, user): see phase1_extras.sql.
model ClubMembership {
  id              String    @id @default(uuid()) @db.Uuid
  clubId          String    @map("club_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  status          String    @default("pending") // "pending" | "active" | "left" | "removed" | "rejected"
  isPlayer        Boolean   @default(true) @map("is_player")
  isCoach         Boolean   @default(false) @map("is_coach")
  isReferee       Boolean   @default(false) @map("is_referee")
  primaryPosition String?   @map("primary_position") // "PG" | "SG" | "SF" | "PF" | "C"
  requestedAt     DateTime  @default(now()) @map("requested_at")
  joinedAt        DateTime? @map("joined_at")
  leftAt          DateTime? @map("left_at")
  approvedById    String?   @map("approved_by") @db.Uuid

  club       Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user       User  @relation("Member", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("MemberApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([userId, status])
  @@map("club_memberships")
}

/// BASE. Owner, admin, captain with history (#14, #15, #44). Replaces chairperson/captain columns.
model ClubRole {
  id          String    @id @default(uuid()) @db.Uuid
  clubId      String    @map("club_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String // "owner" | "admin" | "captain"
  grantedById String?   @map("granted_by") @db.Uuid
  fromAt      DateTime  @default(now()) @map("from_at")
  toAt        DateTime? @map("to_at") // empty = current

  club      Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User  @relation("ClubRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("ClubRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([clubId, role, toAt])
  @@index([userId])
  @@map("club_roles")
}

/// ON TOP. Head and assistant coaches, with or without an account.
/// One head coach per club: see phase1_extras.sql.
model Coach {
  id        String    @id @default(uuid()) @db.Uuid
  clubId    String    @map("club_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  name      String
  phone     String?
  email     String?
  photoUrl  String?   @map("photo_url")
  role      String    @default("assistant") // "head" | "assistant"
  isPrimary Boolean   @default(false) @map("is_primary") // true for the head coach
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  club Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clubId, endedAt])
  @@map("coaches")
}

/// BASE. A club's yearly link to its association (#58, #69).
/// Active + valid_until in the future = "Affiliated" badge.
model Affiliation {
  id             String    @id @default(uuid()) @db.Uuid
  clubId         String    @map("club_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tnbaNumber     String?   @map("tnba_number")
  validFrom      DateTime? @map("valid_from") @db.Date
  validUntil     DateTime? @map("valid_until") @db.Date
  status         String    @default("pending") // "pending" | "active" | "rejected" | "ended"
  startedBy      String    @map("started_by") // "club" | "association"
  requestedById  String?   @map("requested_by") @db.Uuid
  decidedById    String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  club         Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation("AffRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy    User?        @relation("AffDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([organizationId, status])
  @@map("affiliations")
}

/// ON TOP. Badges given by the Basky team: "Verified by BaskyCLub" for clubs/academies (#35)
/// and "Creator" for influencer accounts (#73). Exactly one of club_id / user_id is set.
model VerificationBadge {
  id           String    @id @default(uuid()) @db.Uuid
  clubId       String?   @map("club_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  badge        String    @default("basky_verified") // "basky_verified" (club) | "creator" (user)
  status       String    @default("active") // "active" | "revoked" | "expired"
  verifiedById String?   @map("verified_by") @db.Uuid
  verifiedAt   DateTime  @default(now()) @map("verified_at")
  expiresAt    DateTime? @map("expires_at") // paid badges later

  club       Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user       User? @relation("BadgeHolder", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("BadgeGivenBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([userId, status])
  @@map("verification_badges")
}

/// ON TOP. Physical courts for the Clubs-tab map; club-owned or public.
model Court {
  id               String    @id @default(uuid()) @db.Uuid
  clubId           String?   @map("club_id") @db.Uuid
  name             String
  districtCode     String    @map("district_code")
  indoor           Boolean   @default(false)
  surface          String? // "hardwood" | "synthetic" | "concrete" | "outdoor_asphalt"
  address          String?
  latitude         Decimal?  @db.Decimal(9, 6)
  longitude        Decimal?  @db.Decimal(9, 6)
  imageUrls        String[]  @map("image_urls")
  aiValidated      Boolean   @default(false) @map("ai_validated")
  aiValidationData Json?     @map("ai_validation_data")
  status           String    @default("pending") // "pending" | "approved" | "rejected"
  createdById      String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  club      Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  district  District @relation(fields: [districtCode], references: [code])
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([districtCode, status])
  @@map("courts")
}

/// ON TOP. When a club practices, per weekday.
model ClubCourtTiming {
  id           String  @id @default(uuid()) @db.Uuid
  clubId       String  @map("club_id") @db.Uuid
  dayOfWeek    Int     @map("day_of_week") // 1 = Monday ... 7 = Sunday
  isFullDay    Boolean @default(false) @map("is_full_day")
  morningStart String? @map("morning_start") // "06:00"
  morningEnd   String? @map("morning_end")
  eveningStart String? @map("evening_start")
  eveningEnd   String? @map("evening_end")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, dayOfWeek])
  @@map("club_court_timings")
}

// =============================================================================
// COMMUNITY
// =============================================================================

/// BASE. Owned by its author (#22, #41, #57). Phase 2 adds tournament_id / match_id tags.
model Post {
  id               String    @id @default(uuid()) @db.Uuid
  authorId         String    @map("author_user_id") @db.Uuid
  clubId           String?   @map("club_id") @db.Uuid // club tag; also shows on the club page
  organizationId   String?   @map("organization_id") @db.Uuid // official association post
  districtCode     String?   @map("district_code") // filled automatically (APP_NAV section 6)
  visibility       String    @default("public") // "members" | "club_page" | "public"
  content          String?
  moderationStatus String    @default("published") @map("moderation_status") // "in_review" | "published" | "hidden" | "removed"
  isPinned         Boolean   @default(false) @map("is_pinned")
  likeCount        Int       @default(0) @map("like_count") // kept by the database
  commentCount     Int       @default(0) @map("comment_count") // kept by the database
  shareCount       Int       @default(0) @map("share_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  author       User          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  club         Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  district     District?     @relation(fields: [districtCode], references: [code], onDelete: SetNull)
  pinnedBy     User?         @relation("PinnedPost")
  announcement Announcement? @relation("AnnouncementCard")
  media        PostMedia[]
  likes        PostLike[]
  comments     PostComment[]

  @@index([districtCode, createdAt])
  @@index([clubId, createdAt])
  @@index([authorId, createdAt])
  @@index([moderationStatus, createdAt])
  @@map("posts")
}

/// ON TOP. Several photos / YouTube links per post (#24).
model PostMedia {
  id        String @id @default(uuid()) @db.Uuid
  postId    String @map("post_id") @db.Uuid
  mediaType String @map("media_type") // "image" | "youtube"
  url       String
  sortOrder Int    @default(0) @map("sort_order")
  width     Int?
  height    Int?
  status    String @default("visible") // "visible" | "hidden"

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("post_media")
}

/// ON TOP. One like per person per post.
model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

/// ON TOP. Comments with one level of replies (REQUIREMENTS section 8).
model PostComment {
  id               String    @id @default(uuid()) @db.Uuid
  postId           String    @map("post_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  parentId         String?   @map("parent_id") @db.Uuid // set = a reply; replies always point to a top-level comment
  content          String
  moderationStatus String    @default("published") @map("moderation_status") // "published" | "hidden" | "removed"
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at") // shows "Comment removed"

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("Replies")

  @@index([postId, parentId, createdAt])
  @@map("post_comments")
}

/// ON TOP. One-way follows, Instagram-style: no approval, no follow-back (#64, #73).
/// Players and creators can be followed from Phase 1.
model Follow {
  id         String   @id @default(uuid()) @db.Uuid
  followerId String   @map("follower_user_id") @db.Uuid
  targetType String   @map("target_type") // "club" | "organization" | "user"
  targetId   String   @map("target_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation(fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("follows")
}

/// ON TOP. Review queue: AI flags, user reports, posts by users without a club (#25, #41).
model ModerationCase {
  id           String    @id @default(uuid()) @db.Uuid
  targetType   String    @map("target_type") // "post" | "comment" | "user" | "post_media"
  targetId     String    @map("target_id") @db.Uuid
  source       String // "ai" | "report" | "no_club_review"
  reason       String?
  aiScore      Decimal?  @map("ai_score") @db.Decimal(4, 3)
  status       String    @default("open") // "open" | "approved" | "removed"
  reportedById String?   @map("reported_by") @db.Uuid
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")

  reportedBy User? @relation("CaseReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("CaseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("moderation_cases")
}

/// ON TOP. Phone alerts with a chosen audience (#65).
model Announcement {
  id           String   @id @default(uuid()) @db.Uuid
  senderId     String   @map("sender_user_id") @db.Uuid
  senderOrgId  String?  @map("sender_org_id") @db.Uuid
  senderClubId String?  @map("sender_club_id") @db.Uuid
  // "club_admins_in_area" | "affiliated_members" | "district_users" | "followers" | "club_members" | "everyone"
  audience     String
  districtCode String?  @map("district_code") // for "district_users"
  title        String
  body         String
  showInFeed   Boolean  @default(false) @map("show_in_feed") // "Also show in feed" toggle (#75)
  feedPostId   String?  @unique @map("feed_post_id") @db.Uuid // the pinned Official card it created
  sentAt       DateTime @default(now()) @map("sent_at")

  sender     User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderOrg  Organization? @relation(fields: [senderOrgId], references: [id], onDelete: SetNull)
  senderClub Club?         @relation(fields: [senderClubId], references: [id], onDelete: SetNull)
  district   District?     @relation(fields: [districtCode], references: [code], onDelete: SetNull)
  feedPost   Post?         @relation("AnnouncementCard", fields: [feedPostId], references: [id], onDelete: SetNull)

  @@index([senderOrgId, sentAt])
  @@index([senderClubId, sentAt])
  @@map("announcements")
}
